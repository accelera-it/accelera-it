# ═══════════════════════════════════════════════════════════════════════
#  AcceleraIT — .htaccess
#  Works on Apache and on LiteSpeed (your current server is LiteSpeed).
#  Every block is guarded by <IfModule>, so nothing 500s if a module is off.
# ═══════════════════════════════════════════════════════════════════════

# ── 1. Directory listing OFF ───────────────────────────────────────────
# accelerait.us currently serves a browsable "Index of /" page.
# This closes it.
Options -Indexes

# ── 2. Default document ────────────────────────────────────────────────
DirectoryIndex index.html index.php

# ── 3. Character set ───────────────────────────────────────────────────
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
  RewriteEngine On

  # ── 4. Force HTTPS ───────────────────────────────────────────────────
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # ── 5. Drop the www, matching the canonical tag ──────────────────────
  # Canonical is https://accelerait.us/ — if you would rather standardise
  # on www, comment this block out and uncomment the one below it.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # Prefer www instead? Use this and disable the block above.
  # RewriteCond %{HTTP_HOST} !^www\. [NC]
  # RewriteCond %{HTTP_HOST} !^localhost [NC]
  # RewriteRule ^(.*)$ https://www.%{HTTP_HOST}/$1 [R=301,L]

  # ── 6. Strip a trailing index.html ───────────────────────────────────
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^(.*)index\.html$ /$1 [R=301,L]
</IfModule>

# ── 7. Security headers ────────────────────────────────────────────────
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"

  # HSTS — only switch on once HTTPS is confirmed working on every
  # subdomain, because browsers cache this for a year and it is hard to undo.
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

  # Content-Security-Policy — the site currently loads Tailwind from a CDN,
  # which needs 'unsafe-eval'. Once you switch to a compiled stylesheet,
  # drop cdn.tailwindcss.com and 'unsafe-eval' and enable this line.
  # Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://cdn.tailwindcss.com 'unsafe-eval' 'unsafe-inline'; style-src 'self' https://fonts.googleapis.com 'unsafe-inline'; font-src https://fonts.gstatic.com; img-src 'self' data:; form-action 'self'; base-uri 'self'; frame-ancestors 'self'"

  # Never let a CDN or proxy cache the HTML itself
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# ── 8. Compression ─────────────────────────────────────────────────────
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml \
    application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml \
    application/javascript application/json application/xml image/svg+xml \
    application/manifest+json
</IfModule>

# ── 9. Cache policy ────────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                              "access plus 1 month"
  ExpiresByType text/html                     "access plus 0 seconds"
  ExpiresByType application/xml               "access plus 0 seconds"
  ExpiresByType text/plain                    "access plus 1 day"
  ExpiresByType image/png                     "access plus 1 year"
  ExpiresByType image/jpeg                    "access plus 1 year"
  ExpiresByType image/webp                    "access plus 1 year"
  ExpiresByType image/svg+xml                 "access plus 1 year"
  ExpiresByType image/x-icon                  "access plus 1 year"
  ExpiresByType text/css                      "access plus 1 year"
  ExpiresByType application/javascript        "access plus 1 year"
  ExpiresByType font/woff2                    "access plus 1 year"
  ExpiresByType application/manifest+json     "access plus 1 week"
</IfModule>

# ── 10. Correct MIME types ─────────────────────────────────────────────
<IfModule mod_mime.c>
  AddType image/svg+xml                 .svg
  AddType image/webp                    .webp
  AddType image/x-icon                  .ico
  AddType application/manifest+json     .webmanifest
  AddType font/woff2                    .woff2
</IfModule>

# ── 11. Block access to sensitive files ────────────────────────────────
<FilesMatch "(^\.|~$|\.(bak|config|dist|fla|inc|ini|log|psd|sh|sql|swp|env|json|md)$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Keep the manifest reachable despite the .json rule above
<Files "site.webmanifest">
  <IfModule mod_authz_core.c>
    Require all granted
  </IfModule>
</Files>

# ── 12. Error pages ────────────────────────────────────────────────────
# Single-page site, so send 404s to the landing page rather than a bare
# server error screen. Replace with a real 404.html if you add more pages.
ErrorDocument 404 /index.html
ErrorDocument 403 /index.html
